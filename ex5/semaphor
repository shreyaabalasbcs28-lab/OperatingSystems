#include "header.h"

void wait_sem(int sid, int sno) {
    struct sembuf s;
    s.sem_num = sno;
    s.sem_op = -1;          
    s.sem_flg = 0;   // Changed SEM_UNDO to 0 for resource persistence across forks/execs
    semop(sid, &s, 1);
}

void signal_sem(int sid, int sno) {
    struct sembuf s;
    s.sem_num = sno;
    s.sem_op = 1;           
    s.sem_flg = 0;   // Changed SEM_UNDO to 0 
    semop(sid, &s, 1);
}


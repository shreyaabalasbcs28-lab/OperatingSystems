#include "header.h"

int main() {
    union semaphore snum;
    int sid, in, num, *buf, s, i;
    unsigned short a[3];

    in = 0;
    // IPC_CREAT alone handles access even if the block exists from a previous crash
    s = shmget(2999, sizeof(int) * size, IPC_CREAT | 0666);
    if (s == -1) {
        perror("shmget");
        exit(1);
    } 
    
    buf = (int *)shmat(s, NULL, 0);
    if (buf == (void *)-1) {
        perror("shmat");
        exit(1);
    } 
    
    sid = semget(5999, 3, IPC_CREAT | 0666);
    if (sid == -1) {
        perror("semget");
        exit(1);
    } 
    
    a[0] = 1;    // mutex = 1
    a[1] = 0;    // full = 0
    a[2] = size; // empty = 5
    snum.array = a;
    semctl(sid, 0, SETALL, snum);

    for (i = 0; i < size; i++) {
        printf("Enter the data:\n");
        scanf("%d", &num);

        wait_sem(sid, empty);
        wait_sem(sid, mutex);

        buf[in % size] = num;
        in++;

        signal_sem(sid, mutex);
        signal_sem(sid, full);
    }
    
    shmdt(buf);
    return 0;
}


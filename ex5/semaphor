#include "header.h"

int main() {
    int sid, out, num, *buf, s, i;
    out = 0;

    s = shmget(2999, sizeof(int) * size, 0666);
    if (s == -1) {
        perror("shmget");
        exit(1);
    } 
    
    buf = (int *)shmat(s, NULL, 0);
    if (buf == (void *)-1) {
        perror("shmat");
        exit(1);
    } 
    
    sid = semget(5999, 3, 0666);
    if (sid == -1) { 
        perror("semget");
        exit(1);
    } 

    printf("Data Read:\n");
    for (i = 0; i < size; i++) { 
        wait_sem(sid, full);
        wait_sem(sid, mutex);

        num = buf[out % size];
        out++;

        signal_sem(sid, mutex);
        signal_sem(sid, empty);

        printf("Data[%d]: %d\n", out, num);
    }

    shmdt(buf);
    semctl(sid, 0, IPC_RMID);
    shmctl(s, IPC_RMID, NULL);
    
    return 0;
}

